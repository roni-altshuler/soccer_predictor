.pytest_cache/
.coverage
htmlcov/

# models & training artifacts
*.pkl
*.pt
backend/data/historical/
# Model binaries stay out; the per-league serving policy is a committed
# artifact (Vercel reads it) and must NOT be ignored — `git add` on a tracked
# file inside an ignored directory exits 1 and killed the daily backfill job.
backend/data/models/*
!backend/data/models/model_selection.json
backend/data/warehouse.sqlite
backend/data/warehouse.sqlite-journal
backend/data/warehouse.sqlite-wal
backend/data/warehouse.sqlite-shm
backend/data/cache/
backend/data/raw/

# Agent worktrees
.claude/worktrees/

# screenshot harness (Playwright)
/scripts/screenshots/

# Gemini API Key
gemini.md

.gemini/

# PWA files
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map

# Bulk diagnostics. Only the heavy per-season/per-team dump is ignored — the
# committed `season_projection_summary.json` carries the convergence curve,
# calibration table and per-league results, which is everything the pivot doc
# cites. Regenerate the full artifact with:
#   .venv/bin/python -m backend.scripts.backtest_season_projections
#
# Do NOT blanket-ignore backend/data/diagnostics/. FastAPI is not deployed on
# Vercel, so the deployed evidence pages read committed JSON out of this
# directory directly: league_track_record.json (every league page) and
# market_benchmark.json (the accuracy page). Ignoring the directory blanks
# them in production while everything still works locally.
backend/data/diagnostics/season_projection_backtest.json

# FBref landing zone. The SOURCE OF TRUTH locally, but not the durable
# artefact: it is a working DB that a multi-hour scrape rewrites, and the
# gzipped raw HTML under backend/data/cache/ is already ignored above.
# What gets committed is the Parquet export (backend/data/fbref/parquet),
# which is typed, ~10x smaller than the equivalent CSV, and partitioned by
# league/season so a new season adds a file instead of rewriting the set.
backend/data/fbref.sqlite
backend/data/fbref.sqlite-journal
backend/data/fbref.sqlite-wal
backend/data/fbref.sqlite-shm

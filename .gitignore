# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# logs
/logs
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# virtual environment
.venv/
venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# pytest
.pytest_cache/
.coverage
htmlcov/

# models & training artifacts
*.pkl
*.pt
backend/data/historical/
# Model binaries stay out; the per-league serving policy is a committed
# artifact (Vercel reads it) and must NOT be ignored — `git add` on a tracked
# file inside an ignored directory exits 1 and killed the daily backfill job.
backend/data/models/*
!backend/data/models/model_selection.json
backend/data/warehouse.sqlite
backend/data/warehouse.sqlite-journal
backend/data/warehouse.sqlite-wal
backend/data/warehouse.sqlite-shm
backend/data/cache/
backend/data/raw/

# Agent worktrees
.claude/worktrees/

# screenshot harness (Playwright)
/scripts/screenshots/

# Gemini API Key
gemini.md

.gemini/

# PWA files
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map

# Pitchverse environment variables
# Copy to .env (backend) / .env.local (Next.js) and fill in real values.
# None of these are required for basic local development — sensible
# defaults or graceful degradation exist for every variable.

# ──────────────────────────────────────────────
# Backend (FastAPI)
# ──────────────────────────────────────────────

# REQUIRED in production (startup fails without it). In development an
# ephemeral per-process secret is generated. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# "production" enables fail-fast checks (e.g. JWT secret enforcement).
ENVIRONMENT=development

# Per-IP API rate limit (requests/minute). 0 disables (useful in tests).
RATE_LIMIT_PER_MINUTE=120

# Google OAuth (optional — email/password auth works without it)
GOOGLE_CLIENT_ID=

# Weather features (optional — predictions degrade gracefully without it)
OPENWEATHER_API_KEY=
ALLOW_SIMULATED_WEATHER=false

# Optional data providers
API_FOOTBALL_KEY=
TRANSFERMARKT_ENABLED=false

# LLM adapter (pipeline-time only — see docs/llm.md).
# Used by `python -m backend.scripts.build_boardroom` to write the Boardroom
# debate artifact. NEVER called per-visitor; products read committed artifacts.
# With no key set, the build script exits 0 without writing anything, so the
# pipeline stays green before a key exists. Add a free-tier key to enable it.
GEMINI_API_KEY=
GROQ_API_KEY=
# Force a specific provider: "gemini" | "groq" | "fake". Unset = first available
# key wins, in the order gemini -> groq.
LLM_PROVIDER=
# Optional model overrides (sensible defaults exist).
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.1-8b-instant

# Pipeline / gateway (only needed when running backend/pipeline services)
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
PIPELINE_READ_FROM=sqlite
PIPELINE_CONSUMER_GROUP=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ──────────────────────────────────────────────
# Frontend (Next.js) — put these in .env.local
# NEXT_PUBLIC_* values are exposed to the browser; never put secrets there.
# ──────────────────────────────────────────────

# Base URL the browser uses for /api/v1/* data fetches.
# Local dev: the FastAPI server. Vercel: the deployment's own URL
# (Node API routes serve the same paths there).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side proxy target for Next API routes that forward to FastAPI.
BACKEND_URL=http://127.0.0.1:8000

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GATEWAY_URL=
# Only enable once /api/health reflects real infrastructure (see StatusBanner.tsx)
NEXT_PUBLIC_ENABLE_HEALTH_CHECK=false

# Postgres-backed public sync (bracket rooms, watchlist alerts) — optional
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
PGSSLMODE=require
PGPOOL_MAX=

# The Odds API (betting-intelligence card) — optional, quota-protected
ODDS_API_KEY=
THE_ODDS_API_KEY=
ODDS_API_REGIONS=eu
ODDS_API_DAILY_BUDGET=
ODDS_API_MONTHLY_BUDGET=
ODDS_API_CACHE_TTL_MS=
ODDS_API_STALE_OK_MS=

# The 3D match-reconstruction showcase uses @react-three/fiber v9 + drei v10,
# which peer-depend on React 19. Next.js 15's App Router already serves its
# vendored React 19 to client components at runtime, so this pairing is correct
# even though the repo still declares react/react-dom 18.3.1 for the rest of the
# app. legacy-peer-deps keeps `npm install` (local + Vercel) from failing the
# ERESOLVE peer check on that intentional mismatch.
legacy-peer-deps=true
